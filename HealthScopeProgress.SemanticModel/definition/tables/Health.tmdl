	measure 'Scatter Verdict - Disease mortality' =
			VAR Pairs =
			    FILTER(
			        ADDCOLUMNS(VALUES('Health'[Disease Name]), "@X", 'DimCountry'[Avg Mortality Rate], "@Y", 'DimCountry'[Avg Recovery Rate]),
			        NOT ISBLANK([@X]) && NOT ISBLANK([@Y])
			    )
			VAR Dots = Pairs
			
			VAR N = COUNTROWS(Dots)
			VAR MeanX = AVERAGEX(Dots, [@X])
			VAR MeanY = AVERAGEX(Dots, [@Y])
			VAR Numerator = SUMX(Dots, ([@X] - MeanX) * ([@Y] - MeanY))
			VAR Denominator = SQRT(SUMX(Dots, ([@X] - MeanX)^2) * SUMX(Dots, ([@Y] - MeanY)^2))
			VAR Correlation = DIVIDE(Numerator, Denominator)
			VAR Magnitude = ABS(Correlation)
			VAR ResultText = " (correlation r = " & FORMAT(ROUND(Correlation, 2), "0.00", "en-US") & ")."
			VAR DirectionText = "higher mortality goes with " & IF(Correlation > 0, "higher ", "lower ") & "recovery"
			RETURN
			    SWITCH(TRUE(),
			        N < 5, "Too few points to judge.",
			        ISBLANK(Correlation), "No clear link (correlation undefined).",
			        Magnitude < 0.2, "No clear link" & ResultText,
			        Magnitude < 0.4, "Weak link: " & DirectionText & ResultText,
			        Magnitude < 0.7, "Moderate link: " & DirectionText & ResultText,
			        "Strong link: " & DirectionText & ResultText)
		isHidden
		displayFolder: Scatter explanations
		lineageTag: b11f6bc0-a304-424f-8836-47f40cb56304

	measure 'Scatter How - Disease mortality' =
			VAR Pairs =
			    FILTER(
			        ADDCOLUMNS(VALUES('Health'[Disease Name]), "@X", 'DimCountry'[Avg Mortality Rate], "@Y", 'DimCountry'[Avg Recovery Rate]),
			        NOT ISBLANK([@X]) && NOT ISBLANK([@Y])
			    )
			VAR Dots = Pairs
			
			VAR Highest = TOPN(1, Dots, [@X], DESC, 'Health'[Disease Name], ASC)
			VAR HighestName = CONCATENATEX(Highest, 'Health'[Disease Name])
			VAR HighestValue = MAXX(Highest, [@X])
			VAR NextHighest = MAXX(FILTER(Dots, 'Health'[Disease Name] <> HighestName), [@X])
			RETURN
			    "Each dot is a disease. Further right = higher mortality. Higher up = better recovery." &
			    IF(COUNTROWS(Highest) > 0, " Highest mortality: " & HighestName & " (" &
			        FORMAT(HighestValue, "0.00%", "en-US") & ")" &
			        IF(NOT ISBLANK(NextHighest) && HighestValue > 2 * NextHighest, ", far above most others.", "."), "")
		isHidden
		displayFolder: Scatter explanations
		lineageTag: 529b7d55-623b-464d-b57a-a71fc8ee57c8

	measure 'Scatter Header - Disease mortality' =
			VAR MainVerdict = [Scatter Verdict - Disease mortality]
			VAR FirstWord = LEFT(MainVerdict, FIND(" ", MainVerdict & " ") - 1)
			VAR VerdictStyle = IF(FirstWord IN {"Weak", "Moderate", "Strong"}, " scatter-verdict-link", "")
			RETURN
			"<div class='scatter-title'>Mortality and recovery by disease</div><div class='scatter-how'>" & [Scatter How - Disease mortality] &
			"</div><div class='scatter-verdict" & VerdictStyle & "'>" & MainVerdict & [Scatter Sensitivity - Disease mortality] & "</div>"
		isHidden
		displayFolder: Scatter explanations
		lineageTag: 3caea549-9945-47cc-9f92-4966c479916a

