	measure 'Trend Rank - Country' =
			VAR CurrentName = SELECTEDVALUE('DimCountry'[Country])
			VAR CurrentScore = [Selected Measure Value]
			VAR Candidates =
			    ADDCOLUMNS(ALLSELECTED('DimCountry'[Country]), "@Score", [Selected Measure Value])
			RETURN
			    IF(ISBLANK(CurrentName) || ISBLANK(CurrentScore), 1000000,
			        1 + COUNTROWS(
			            FILTER(Candidates, NOT ISBLANK([@Score]) &&
			                ([@Score] > CurrentScore || ([@Score] = CurrentScore && 'DimCountry'[Country] < CurrentName)))))
		isHidden
		displayFolder: Measure selector
		lineageTag: 900856f7-4a42-4f7c-a58f-ca9c12e74d9e

	measure 'Trend Rank - Disease Name' =
			VAR CurrentName = SELECTEDVALUE('Health'[Disease Name])
			VAR CurrentScore = [Selected Measure Value]
			VAR Candidates =
			    ADDCOLUMNS(ALLSELECTED('Health'[Disease Name]), "@Score", [Selected Measure Value])
			RETURN
			    IF(ISBLANK(CurrentName) || ISBLANK(CurrentScore), 1000000,
			        1 + COUNTROWS(
			            FILTER(Candidates, NOT ISBLANK([@Score]) &&
			                ([@Score] > CurrentScore || ([@Score] = CurrentScore && 'Health'[Disease Name] < CurrentName)))))
		isHidden
