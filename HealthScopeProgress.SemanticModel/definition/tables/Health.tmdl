			RETURN
			"<div class='scatter-title'>Healthcare access and average mortality</div><div class='scatter-how'>" & [Scatter How - Healthcare access] &
			"</div><div class='scatter-verdict" & VerdictStyle & "'>" & MainVerdict & "</div>"
		isHidden
		displayFolder: Scatter explanations
		lineageTag: 3941839d-cf58-4d38-964f-8b9122377f79

	measure 'Scatter Sensitivity - Disease mortality' =
			VAR Dots =
			    FILTER(
			        ADDCOLUMNS(VALUES('Health'[Disease Name]), "@X", 'DimCountry'[Avg Mortality Rate], "@Y", 'DimCountry'[Avg Recovery Rate]),
			        NOT ISBLANK([@X]) && NOT ISBLANK([@Y])
			    )
			VAR Highest = TOPN(1, Dots, [@X], DESC, 'Health'[Disease Name], ASC)
			VAR HighestName = CONCATENATEX(Highest, 'Health'[Disease Name])
			VAR Remaining = FILTER(Dots, 'Health'[Disease Name] <> HighestName)
			VAR NextHighest = MAXX(Remaining, [@X])
			VAR HasOutlier = NOT ISBLANK(NextHighest) && MAXX(Highest, [@X]) > 2 * NextHighest
			RETURN
			    IF(HasOutlier && COUNTROWS(Remaining) >= 5,
			        VAR MeanX = AVERAGEX(Remaining, [@X])
			        VAR MeanY = AVERAGEX(Remaining, [@Y])
			        VAR Numerator = SUMX(Remaining, ([@X] - MeanX) * ([@Y] - MeanY))
			        VAR Denominator = SQRT(SUMX(Remaining, ([@X] - MeanX)^2) * SUMX(Remaining, ([@Y] - MeanY)^2))
			        VAR ReducedR = DIVIDE(Numerator, Denominator)
			        VAR Magnitude = ABS(ReducedR)
			        VAR Strength = SWITCH(TRUE(), Magnitude < 0.2, "no clear link",
			            Magnitude < 0.4, "weak link", Magnitude < 0.7, "moderate link", "strong link")
			        RETURN
			            " Without " & HighestName & ": " &
			            IF(ISBLANK(ReducedR), "no clear link (correlation undefined).",
			                Strength & " (correlation r = " & FORMAT(ROUND(ReducedR, 2), "0.00", "en-US") & ").")
			    )
		isHidden
		displayFolder: Scatter explanations
		lineageTag: d764a721-59d7-474c-a69a-61ab03e2e556

