model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-MY
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Health"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table Health
ref table DimYear
ref table DimCountry
ref table Measure
ref table 'Treatment Measure'
ref table 'Entity Colours'

ref cultureInfo en-US

